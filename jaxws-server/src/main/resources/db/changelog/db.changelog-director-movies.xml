    <changeSet id="create-director-movies-table" author="imazolevska">
        <createTable tableName="director_movies">
            <column name="director_id" type="INT">
                <constraints nullable="false"
                             foreignKeyName="fk_director_movies_director"
                             references="director(id)"/>
            </column>
            <column name="movie_id" type="INT">
                <constraints nullable="false"
                             unique="true"
                             uniqueConstraintName="uk_director_movies_movie"
                             foreignKeyName="fk_director_movies_movie"
                             references="movie(id)"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="director_movies"
                       columnNames="director_id, movie_id"
                       constraintName="pk_director_movies"/>
    </changeSet>

    <changeSet id="insert-director-movies" author="imazolevska">

